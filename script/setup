#!/bin/bash

# Dotfiles vars
export DOTFILES="${HOME}/.dotfiles"
export DOTFILES_CONFIGS_DIR="${DOTFILES}/configs"
export RUBY_VERSION="3.4.3"
export ERLANG_VERSION="28.5"
export ELIXIR_VERSION="1.19.5"
export NODEJS_VERSION="24.15.0"

command_exists () {
  command "$1" &> /dev/null ;
}


####################################################################
# Installing Xcode Command Line Tools
####################################################################

if ! xcode-select -p &> /dev/null; then
  echo "Installing Xcode Command Line Tools..."
  xcode-select --install
  echo "Waiting for installation to finish (accept the dialog)..."
  until xcode-select -p &> /dev/null; do sleep 5; done
fi

####################################################################
# Installing brew packages
####################################################################

echo "Installing packages from Brewfile..."
brew bundle

####################################################################
# Configuring the shell
####################################################################

fish_path=$(command -v fish)

# Register fish in /etc/shells so chsh accepts it
if ! grep -qx "${fish_path}" /etc/shells; then
  echo "${fish_path}" | sudo tee -a /etc/shells
fi

# Use fish as default shell
chsh -s "${fish_path}"

# Symlink fish config
mkdir -p ~/.config/fish
ln -sf ${DOTFILES_CONFIGS_DIR}/fish/config.fish ~/.config/fish/config.fish
ln -sf ${DOTFILES_CONFIGS_DIR}/fish/conf.d ~/.config/fish/conf.d
ln -sf ${DOTFILES_CONFIGS_DIR}/fish/completions ~/.config/fish/completions

# Symlink starship config
ln -sf ${DOTFILES_CONFIGS_DIR}/starship.toml ~/.config/starship.toml

# Symlink ghostty config
mkdir -p ~/.config/ghostty
ln -sf ${DOTFILES_CONFIGS_DIR}/ghostty/config ~/.config/ghostty/config

echo "Shell configured!"

####################################################################
# Configuring Git
####################################################################

echo "Configuring Git..."
echo "Moving configuration files..."

ln -sf ${DOTFILES_CONFIGS_DIR}/gitconfig ~/.gitconfig
ln -sf ${DOTFILES_CONFIGS_DIR}/gitignore ~/.gitignore
ln -sf ${DOTFILES_CONFIGS_DIR}/gitmessage ~/.gitmessage

echo "Done!"

####################################################################
# Configuring asdf-managed languages
####################################################################

echo "Configuring asdf-managed languages..."

ln -sf ${DOTFILES_CONFIGS_DIR}/gemrc ~/.gemrc
ln -sf ${DOTFILES_CONFIGS_DIR}/railsrc ~/.railsrc
touch ~/.irb-history

echo "Adding asdf plugins..."
asdf plugin add ruby https://github.com/asdf-vm/asdf-ruby.git || true
asdf plugin add erlang https://github.com/asdf-vm/asdf-erlang.git || true
asdf plugin add elixir https://github.com/asdf-vm/asdf-elixir.git || true
asdf plugin add nodejs https://github.com/asdf-vm/asdf-nodejs.git || true

echo "Installing Ruby ${RUBY_VERSION}..."
asdf install ruby ${RUBY_VERSION}
asdf set -u ruby ${RUBY_VERSION}

echo "Installing Erlang ${ERLANG_VERSION}..."
asdf install erlang ${ERLANG_VERSION}
asdf set -u erlang ${ERLANG_VERSION}

echo "Installing Elixir ${ELIXIR_VERSION}..."
asdf install elixir ${ELIXIR_VERSION}
asdf set -u elixir ${ELIXIR_VERSION}

echo "Installing Node.js ${NODEJS_VERSION}..."
asdf install nodejs ${NODEJS_VERSION}
asdf set -u nodejs ${NODEJS_VERSION}

####################################################################
# Linking Claude Code agents and skills
####################################################################

echo "Linking Claude Code agents and skills..."

mkdir -p ~/.claude/agents ~/.claude/skills

for agent in ${DOTFILES}/claude/agents/*.md; do
  ln -sf "${agent}" ~/.claude/agents/
done

for skill in ${DOTFILES}/claude/skills/*/; do
  ln -sf "${skill%/}" ~/.claude/skills/
done

####################################################################
# Setup src/ directory
####################################################################

echo "Creating src directory..."
mkdir -p ~/src/private


####################################################################
# Next steps
####################################################################

cat <<EOF

Setup complete! Next steps:

  1. Open a new terminal so fish becomes the active shell.
  2. Authenticate the GitHub CLI:
       gh auth login
  3. Generate an SSH key (if you don't have one) and add it to GitHub:
       ssh-keygen -t ed25519 -C "your.email@example.com"
       gh ssh-key add ~/.ssh/id_ed25519.pub --title "$(scutil --get ComputerName)"
  4. Sign in to Claude Code:
       claude /login
  5. Configure opencode providers:
       opencode auth login

EOF
