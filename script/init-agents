#!/bin/bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
AGENTS_CONFIG_DIR="${DOTFILES}/configs/agents"

link_config_file() {
  local source="$1"
  local target="$2"
  local name="$3"

  if [ -e "${target}" ] && [ ! -L "${target}" ] && ! cmp -s "${source}" "${target}"; then
    echo "Skipping existing ${name}: ${target}"
    return
  fi

  ln -sfn "${source}" "${target}"
  echo "Linked ${name}: ${target}"
}

link_managed_entry() {
  local source="$1"
  local target="$2"
  local name="$3"

  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    echo "Skipping existing non-symlink ${name}: ${target}"
    return
  fi

  ln -sfn "${source}" "${target}"
  echo "Linked ${name}: ${target}"
}

mkdir -p ~/.agents/skills ~/.agents/rules ~/.claude/skills ~/.claude/agents ~/.claude/rules ~/.codex/agents ~/.codex/rules ~/.local/bin

link_config_file "${AGENTS_CONFIG_DIR}/claude_settings.json" ~/.claude/settings.json "Claude settings"
link_config_file "${AGENTS_CONFIG_DIR}/codex/config.toml" ~/.codex/config.toml "Codex settings"
link_config_file "${AGENTS_CONFIG_DIR}/codex/AGENTS.md" ~/.codex/AGENTS.md "Codex instructions"
link_config_file "${AGENTS_CONFIG_DIR}/codex/rules/default.rules" ~/.codex/rules/default.rules "Codex rules"

for skill in "${AGENTS_CONFIG_DIR}"/skills/*/; do
  skill="${skill%/}"
  skill_name="$(basename "${skill}")"

  link_managed_entry "${skill}" "${HOME}/.agents/skills/${skill_name}" "skill"
  link_managed_entry "${skill}" "${HOME}/.claude/skills/${skill_name}" "skill"
done

for agent_path in "${AGENTS_CONFIG_DIR}"/claude/agents/*; do
  [ -e "${agent_path}" ] || continue
  agent_name="$(basename "${agent_path}")"
  link_managed_entry "${agent_path}" "${HOME}/.claude/agents/${agent_name}" "Claude agent"
done

for agent_path in "${AGENTS_CONFIG_DIR}"/codex/agents/*.toml; do
  [ -f "${agent_path}" ] || continue
  agent_name="$(basename "${agent_path}")"
  link_managed_entry "${agent_path}" "${HOME}/.codex/agents/${agent_name}" "Codex agent"
done

for rule_path in "${AGENTS_CONFIG_DIR}"/rules/*.md; do
  [ -f "${rule_path}" ] || continue
  rule_name="$(basename "${rule_path}")"
  link_managed_entry "${rule_path}" "${HOME}/.agents/rules/${rule_name}" "agent rule"
  link_managed_entry "${rule_path}" "${HOME}/.claude/rules/${rule_name}" "Claude rule"
done

for command_path in "${AGENTS_CONFIG_DIR}"/commands/*; do
  [ -f "${command_path}" ] || continue
  link_managed_entry "${command_path}" "${HOME}/.local/bin/$(basename "${command_path}")" "command"
done
