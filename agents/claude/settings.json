{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc)"
    ]
  },
  "model": "sonnet",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gflow@gflow": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true
}
