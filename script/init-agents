#!/bin/bash

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
AGENTS_CONFIG_DIR="${DOTFILES}/configs/agents"

link_settings() {
  local source="$1"
  local target="$2"

  if [ -e "${target}" ] && [ ! -L "${target}" ] && ! cmp -s "${source}" "${target}"; then
    echo "Skipping existing Claude settings: ${target}"
    return
  fi

  ln -sfn "${source}" "${target}"
  echo "Linked Claude settings: ${target}"
}

link_skill() {
  local source="$1"
  local target="$2"

  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    echo "Skipping existing non-symlink skill: ${target}"
    return
  fi

  ln -sfn "${source}" "${target}"
  echo "Linked skill: ${target}"
}

link_command() {
  local source="$1"
  local target="$2"

  if [ -e "${target}" ] && [ ! -L "${target}" ]; then
    echo "Skipping existing non-symlink command: ${target}"
    return
  fi

  ln -sfn "${source}" "${target}"
  echo "Linked command: ${target}"
}

mkdir -p ~/.agents/skills ~/.claude/skills ~/.local/bin

link_settings "${AGENTS_CONFIG_DIR}/claude_settings.json" ~/.claude/settings.json

for skill in "${AGENTS_CONFIG_DIR}"/skills/*/; do
  skill="${skill%/}"
  skill_name="$(basename "${skill}")"

  link_skill "${skill}" "${HOME}/.agents/skills/${skill_name}"
  link_skill "${skill}" "${HOME}/.claude/skills/${skill_name}"
done

for command_path in "${AGENTS_CONFIG_DIR}"/commands/*; do
  [ -f "${command_path}" ] || continue
  link_command "${command_path}" "${HOME}/.local/bin/$(basename "${command_path}")"
done
